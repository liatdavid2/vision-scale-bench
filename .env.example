# Copy to .env. Never commit the real .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-central-1
AWS_REGION=eu-central-1
EKS_CLUSTER_NAME=vision-scale-bench
EKS_GPU_INSTANCE_TYPE=g4dn.xlarge
# Used only if live EC2 Spot lookup fails.
EKS_GPU_SPOT_FALLBACK_RATE=0.30
# Conservative reference rate for the UI estimate; Managed Spot may bill less.
SAGEMAKER_GPU_REFERENCE_RATE=0.7364
